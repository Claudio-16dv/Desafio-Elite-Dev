# ===== Backend =====
NODE_ENV=development
PORT=3333

# Banco de dados
# Local: Postgres do Docker (docker compose). Em produção: Supabase
#   - DATABASE_URL: em produção use a conexão POOLED do Supabase (porta 6543)
#   - DIRECT_URL:   conexão direta (porta 5432), usada pelas migrations
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elite_dev?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/elite_dev?schema=public

# Auth (JWT próprio)
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=1d

# QR do ingresso (assinatura HMAC)
QR_SECRET=dev-qr-secret-change-me

# TMDb (catálogo de filmes)
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# Reservas (janela de compra: reserva fica HELD por N minutos e libera sozinha)
RESERVATION_TTL_MINUTES=5

# CORS (origem do front)
CORS_ORIGIN=http://localhost:3000

# Stripe — o PAGAMENTO só funciona em PRODUÇÃO (exige chaves reais de teste do Stripe).
# Localmente, deixe os placeholders abaixo: eles passam na validação e a aplicação sobe
# normalmente; apenas o fluxo de pagamento vai falhar (todo o resto funciona).
STRIPE_SECRET_KEY=sk_test_placeholder_local_apenas_para_subir
STRIPE_WEBHOOK_SECRET=whsec_placeholder_local_apenas_para_subir

# ===== Frontend =====
API_URL=http://localhost:3333

# Stripe (chave pública, embutida no build do Next). Placeholder local — pagamento só em produção.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_local_apenas_para_subir
