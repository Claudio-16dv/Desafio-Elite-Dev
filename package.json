{
  "name": "desafio-elite-dev",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma de Eventos e Ingressos - Desafio Elite Dev",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w @app/shared",
    "build": "npm run build -w @app/shared && npm run build -w @app/backend && npm run build -w @app/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:backend": "npm run start:dev -w @app/backend",
    "dev:frontend": "npm run dev -w @app/frontend"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
