# syntax=docker/dockerfile:1
# Imagem usada SOMENTE para rodar os testes dentro do Docker (não é a imagem de produção).
# Traz o repositório inteiro + dependências de desenvolvimento (jest, vitest, prisma CLI).
FROM node:22-slim
WORKDIR /repo

# Prisma precisa de openssl
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# manifestos primeiro (cache de dependências)
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/backend/package.json apps/backend/
COPY apps/frontend/package.json apps/frontend/
RUN npm ci

# código + preparação (compila o @app/shared e gera o Prisma Client)
COPY . .
RUN npm run build:shared && npm run prisma:generate -w @app/backend

# unitários do back (sem banco) + testes do front + integração do back (contra o serviço "db")
CMD ["sh", "-lc", "npm run test -w @app/backend && npm run test -w @app/frontend && cd apps/backend && npx jest --config jest-e2e.config.js --runInBand"]
